USE AAD 
GO

DECLARE @order VARCHAR(30) = '###' ----compare HJ and FT Status----
SELECT 'HJ & FT STATUS', o.status as HJStatus, o.order_date, o.route, o.store_order_number, o.carrier, o.latest_ship_date, o.ship_to_state, o.ship_to_country_code,oh.OrderID, oh.Status as FTStatus,oh.ContainerizationError, oh.BlueToteOrder,oh.QtyRequired, oh.QtyPicked, oh.QtyShipped
FROM AAD.dbo.t_order o WITH(NOLOCK)
LEFT JOIN FASTTRAK.vitamz.vitahost.tblOrderHeader oh WITH(NOLOCK)
ON o.order_number = oh.OrderNumber COLLATE Latin1_General_CI_AI
WHERE o.order_number = @order

SELECT comment_text  
FROM dbo.t_order_comment 
WHERE order_number = @order

SELECT 't_order_date' AS t_order_date, * 
FROM dbo.t_order_date 
WHERE order_number = @order
SELECT 'status_log',* 
FROM dbo.t_order_status_log WITH (NOLOCK) 
WHERE order_number = @order  

SELECT * 
FROM dbo.t_order_additional_data oda WITH (NOLOCK)\r\n
JOIN t_order o ON oda.identifier = o.store_order_number\r\n
WHERE o.order_number = @order\r\n \r\n----
FROM D365\r\n
SELECT 'D365 SO Header',TransactionCode, TranDttm, WhseID, OrderNumber, StoreOrder, EntryDate, ShipVia, Residential 
FROM dbo.T_AL_DAX_ORDER_MASTER_SO 
WHERE OrderNumber= @order
SELECT distinct ord.order_number, ord.store_order_number, dax.LineNumber,dax.ItemNumber AS AXItemNumber, dax.ExpectedQty, dax.VCLineStatus,\r\nmast.alt_item_number, mast.item_number as UPC, mast.inv_cat, mast.inspection_code, mast.haz_material\r\n
FROM T_AL_DAX_ORDER_LINE dax with(nolock)
LEFT JOIN t_order ord with(nolock) on dax.OrderNumber=ord.order_number collate Latin1_General_BIN
LEFT JOIN t_item_master mast with(nolock) on dax.ItemNumber=mast.alt_item_number collate Latin1_General_BIN
WHERE dax.OrderNumber= @order
---- when qty_shipped is 0, there is usually a remove Requirements in ParcelLog----
--SELECT 'ORDER_DETAIL', * 
FROM t_order_detail WITH (NOLOCK) 
WHERE order_number = @order
SELECT 'ORDERDETAILS WITH LOCS', si.item_number, im.alt_item_number as AX#, od.line_number as line#, im.description,od.bo_qty,od.bo_description, im.haz_material, im.unit_weight, im.nested_volume, si.actual_qty, si.type, si.status, l.type, l.location_id, l.aisle,  pzl.location_id AS 'PickZoneLoca', tl.Location AS 'FastTrak.tblLocation', tl.Area
FROM t_order_detail od
LEFT JOIN t_stored_item si\r\nON od.item_number = si.item_number
LEFT JOIN t_item_master im ON si.item_number= im.item_number
LEFT JOIN t_location l ON si.location_id = l.location_id
LEFT JOIN t_pick_zone_loca pzl WITH(NOLOCK) ON pzl.location_id = l.location_id
LEFT JOIN FASTTRAK.vitamz.vitahost.tblLocation tl WITH(NOLOCK) ON tl.Location COLLATE Latin1_General_BIN= l.location_id
WHERE od.order_number = @order
SELECT 'FWDPICK',* FROM t_fwd_pick with(nolock) where item_number in (SELECT item_number from t_order_detail with(nolock) 
WHERE order_number=@order)
SELECT 'MISSING CUBISCAN', mast.item_number, mast.alt_item_number as AX#,\r\nod.line_number as line#, mast.description
FROM t_item_master mast with(nolock)
LEFT JOIN  t_stored_item si with(nolock) on mast.item_number=si.item_number
LEFT JOIN t_cubiscan_shipping_dimensions cb with(nolock) on mast.item_number=cb.item_number
LEFT JOIN t_order_detail od
ON si.item_number = od.item_number
WHERE mast.inspection_code !='D' 
AND ((cb.length=0 or cb.length is null) or (cb.width=0 or cb.width is NULL) or (cb.height=0 or cb.height is NULL) or (cb.unit_volume=0 or cb.unit_volume is NULL) or (cb.nested_volume=0 or cb.nested_volume is NULL))\r\nAND od.order_number = @order\r\nGROUP by mast.item_number, mast.alt_item_number,\r\nod.line_number, mast.description\r\norder by mast.item_number\r\n \r\n
SELECT 'TBLPARCEL', p.ParcelID, p.ParcelType, p.Status, p.InductionStatus, p.ManifestStatus, p.QtyRequired, p.QtyPicked,\r\np.CheckWeighed, p.QCComplete, p.QCFailed, p.Weight \r\n
FROM  FASTTRAK.vitamz.vitahost.tblParcel p\r\nJOIN FASTTRAK.vitamz.vitahost.tblOrderHeader oh WITH(NOLOCK)\r\n
ON p.OrderID = oh.OrderID\r\n
WHERE oh.OrderNumber =  @order\r\n \r\n
SELECT 'PARCEL DETAIL', PD.ParcelID, P.Status, P.ParcelNumber, PD.ItemNumber, PD.QCComplete,\r\nPD.QtyRequired, PD.QtyPicked, SUM(PD.QtyRequired- PD.QtyPicked) as Missing, PD.PickCount\r\n
FROM FASTTRAK.vitamz.vitahost.tblOrderHeader OH\r\nJOIN FASTTRAK.vitamz.vitahost.tblParcel P\r\nON OH.OrderID = P.OrderID\r\nJoin FASTTRAK.vitamz.vitahost.tblParcelDetail PD\r\nON P.ParcelID = PD.ParcelID\r\nWHERE OH.OrderNumber = @order\r\nGROUP BY OH.OrderID, PD.ParcelID, P.Status, P.ParcelNumber, PD.ItemNumber, PD.QCComplete,\r\nPD.QtyRequired, PD.QtyPicked, PD.QtyRequired, PD.QtyPicked, PD.PickCount\r\n \r\n
SELECT 'PICK LOCATION', order_number, line_number, pick_id, type, status, item_number, planned_quantity,\r\npicked_quantity, loaded_quantity, pick_location, pick_area\r\n
FROM AAD.dbo.t_pick_detail WITH(NOLOCK) 
WHERE order_number = @order\r\n\r\n
SELECT 'DEFICIENT PICK', order_number, line_number, pick_id, type, status, item_number, planned_quantity, picked_quantity, loaded_quantity, pick_location, pick_area\r\n
FROM AAD.dbo.t_pick_detail WITH(NOLOCK)\r\n
WHERE order_number = @order\r\n    AND planned_quantity > picked_quantity\r\n \r\n    
------------ SHORT PICKS\r\n
SELECT 'SHORTPICKS', * 
FROM tblShortPick 
WHERE order_number = @order\r\n \r\n
---- confirm items with 0 qty from order detail are missing from Pick Detail----\r\n
SELECT 'PICK DETAIL', pd.order_number, pd.line_number, pd.pick_id, pd.type, pd.status, pd.item_number, pd.planned_quantity, pd.picked_quantity, pd.loaded_quantity,\r\npd.pick_location, pd.pick_area, loc.zone\r\n
FROM AAD.dbo.t_pick_detail pd WITH(NOLOCK)\r\n
JOIN t_location loc WITH (NOLOCK) ON pd.pick_location = loc.location_id\r\n
WHERE order_number = @order\r\n \r\n
SELECT 'PARCEL PICKS', PZ.ParcelID, PZ.Area, PZ.Zone, PPI.QtyRequired, PPI.QtyPicked, SUM(PPI.QtyRequired- PPI.QtyPicked) as Missing,\r\nPPI.Visited, PPI.ItemNumber\r\n
FROM FASTTRAK.vitamz.vitahost.tblOrderHeader OH\r\nLeft Join FASTTRAK.vitamz.vitahost.tblParcel P\r\nON OH.OrderID = P.OrderID\r\nLeft Join FASTTRAK.vitamz.vitahost.tblParcelPickZone PZ\r\nON P.ParcelID = PZ.ParcelID\r\n
LEFT JOIN FASTTRAK.vitamz.vitahost.tblParcelPickLocation PL\r\nON PZ.ParcelID = PL.ParcelID\r\n
LEFT JOIN FASTTRAK.vitamz.vitahost.tblParcelPickItem PPI\r\nON PZ.ParcelID = PPI.ParcelID\r\n
WHERE OH.OrderNumber = @order\r\nGROUP BY PZ.ParcelID, PZ.Area, PZ.Zone, PPI.QtyRequired, PPI.QtyPicked,PPI.Visited, PPI.ItemNumber\r\n---- If Remove Requirements filter does not return any values, remove that filter and re- query----\r\n
SELECT 'PARCELLOG', oh.OrderNumber, pl.ParcelID, pl.OrderID, pl.LogType, pl.LogTime, pl.UserName, pl.ItemNumber, pl.Qty, pl.ErrorMessage, pl.User1\r\n
FROM FASTTRAK.vitamz.vitahost.tblParcelLog pl\r\n
JOIN FASTTRAK.vitamz.vitahost.tblOrderHeader oh\r\nON oh.OrderID = pl.OrderID\r\n
WHERE oh.OrderNumber = @order\r\nORDER BY pl.LogTime\r\n--LogType = 'Induct Calvel'\r\n--AND pl.User1 = 'Remove Requirement' \r\n \r\n----Select the ItemNumber from tblParcelLog with Remove Requirements, and filter in this query----\r\n
SELECT 'TRAN LOG', tran_type, description, start_tran_date, start_tran_time, employee_id, hu_id, control_number, location_id, item_number, tran_qty, location_id_2\r\n
FROM AAD.dbo.t_tran_log WITH(NOLOCK)\r\n
WHERE control_number = @order\r\n    --AND item_number = '076280884500'\r\nORDER BY start_tran_date, start_tran_time\r\n \r\n
SELECT 'tblUpLoad', * 
FROM FASTTRAK.vitaxfer.dbo.tblUpLoad 
WHERE order_number = @order\r\n
SELECT 'tblDownLoad', * 
FROM FASTTRAK.vitaxfer.dbo.tblDownLoad 
WHERE order_number = @order\r\n \r\n
SELECT 'SHIP INFO', ecom_ship_complete, track_no, carrier 
FROM FASTTRAK.vitaxfer.dbo.tblVitaFreight\r\n
WHERE pkgid = @order\r\n \r\n
SELECT 'SOUP', TranDttm, WarehouseID, CarrierCode, Status, TotalWeight, VCTTracking, LoadID  \r\n
FROM T_AL_DAX_IVC_MASTER\r\n
WHERE OrderNumber = @order\r\n \r\n
SELECT 'SOUP DETAILS', mast.OrderNumber,mast.Status,m.item_number,det.ItemNumber, det.LineNumber,CONVERT(INT,det.QuantityShipped) AS QtyShipped\r\n
FROM dbo.T_AL_DAX_IVC_MASTER mast WITH(NOLOCK)\r\n
JOIN dbo.T_AL_DAX_IVC_DETAIL det WITH(NOLOCK) ON mast.hjs_node_id=det.hjs_parent_id\r\nLEFT join t_item_master m WITH(NOLOCK) ON det.ItemNumber=m.alt_item_number COLLATE Latin1_General_BIN\r\n
WHERE mast.OrderNumber=@order\r\nORDER BY mast.Status\r\n \r\n
SELECT 'VITAFREIGHT', vf.carname, vf.track_no, vf.prod_desc, vf.act_wgt, vf.ecom_ship_complete, vf.ship_pallet_id,\r\nvf.dock_status, pm.PalletLP, tm.TruckLP, tm.CloseDate as TruckClosed \r\n
FROM FASTTRAK.vitaxfer.dbo.tblVitaFreight vf\r\n
LEFT JOIN FASTTRAK.vitaxfer.shipdock.tblPalletMaster pm\r\n    on vf.ship_pallet_id = pm.PalletLP\r\n
LEFT JOIN FASTTRAK.vitaxfer.shipdock.tblTruckMaster tm\r\n    on pm.TruckID = tm.TruckLP\r\n
WHERE vf.pkgid = @order"
}
